# Copy this file to .env and fill in your values. Never commit .env.

# Required. NCBI uses this to contact you before blocking your requests.
NCBI_EMAIL=you@example.com

# Recommended. Free at https://www.ncbi.nlm.nih.gov/account/settings/
# Raises the rate limit from ~3 req/s to ~10 req/s.
NCBI_API_KEY=

# Optional. Identifies your tool to NCBI. Defaults to "pubmed-if-filter".
NCBI_TOOL=pubmed-if-filter

# Optional. Override the auto-selected requests/sec (10 with API key, 3 without).
# NCBI_MAX_RPS=10
